# This file defines the environment for docker-compose for running on a local machine.
# If you want to have them available also within the docker containers, you need to add them to the
# 'environments' section of x-airflow-common

ENV_NAME=local

# ports where the UIs will be served
WEBSERVER_PORT=8080
WEBAPP_PORT=8501

# credentials for Airflow UI
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# Airflow 3: how workers reach the api-server (must be reachable from every worker host, cf. POSTGRES_HOST)
AIRFLOW_APISERVER_HOST=airflow-apiserver  # access through compose-internal network (service name)
AIRFLOW_APISERVER_PORT=8080
# Airflow 3: the URL of the Airflow UI as seen from the browser
AIRFLOW_BASE_URL=http://localhost:8080
# Airflow 3: secret to sign the tokens between api-server, workers and UI (identical on all machines)
AIRFLOW_JWT_SECRET=local-dev-jwt-secret

MONGO_USER_READWRITE=mongo
MONGO_PASSWORD_READWRITE=mongo
MONGO_USER_READ=mongoread
MONGO_PASSWORD_READ=mongoread
MONGO_USER_WEBAPP=mongowebapp
MONGO_PASSWORD_WEBAPP=mongowebapp

MONGO_HOST=mongodb-service  # access through compose-internal network (service name)
#MONGO_HOST=host.docker.internal  # access through localhost for Mac
#MONGO_HOST=172.17.0.1  # access through localhost for Linux
MONGO_PORT=27017

POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

REDIS_HOST=redis-service
REDIS_PORT=6379

# all mounts (backup pool folders, results pool folders, instruments) need to be available in MOUNTS_PATH, cf. Readme
# Note: must be absolute (if relative, e.g. in local tests, docker job runner will not work)
MOUNTS_PATH=./local_test/mounts

## DOCKER ENGINE
# Set to "true" to build the airflow image with the optional requirements of the `docker` job engine
# (standalone deployments without a cluster).
# INSTALL_DOCKER_ENGINE=true
# Group id of the docker group, required only for the `docker` job engine (standalone deployments
# without a cluster) on Linux hosts, where the socket is owned by the `docker` group:
# `stat -c '%g' /var/run/docker.sock`. Not needed on Docker Desktop (macOS/Windows), where the socket
# appears as root:root inside the container, so the default of 0 already grants access.
# DOCKER_GID=999
