# This file defines the environment for docker-compose for running a 'production' version.
# If you want to have them available also within the docker containers, you need to add them to the
# 'environments' section of x-airflow-common

ENV_NAME=production

WEBAPP_PORT=8501

# credentials for Airflow UI
AIRFLOW_USER=<airflow_user>
#AIRFLOW_PASSWORD=<password>

MONGO_USER_READWRITE=<mongo_user>
#MONGO_PASSWORD_READWRITE=<password>
MONGO_USER_READ=<mongo_user_read>
#MONGO_PASSWORD_READ=<password>
MONGO_USER_WEBAPP=<mongo_user_webapp>
#MONGO_PASSWORD_WEBAPP=<password>

#MONGO_HOST=<mongo_host> # if this deployment must access this service on another machine
MONGO_HOST=mongodb-service # if this deployment can access this service within the same docker-compose network, set MONGO_PORT=27017
MONGO_PORT=27017

# How workers reach the api-server (must be reachable from every worker host, cf. POSTGRES_HOST)
AIRFLOW_APISERVER_HOST=airflow-apiserver  # access within docker-compose network, set AIRFLOW_APISERVER_PORT=8080
#AIRFLOW_APISERVER_HOST=<airflow_infrastructure_host>  # access on another machine, set AIRFLOW_APISERVER_PORT
AIRFLOW_APISERVER_PORT=8080
# The URL of the Airflow UI as typed into the browser.
# Used for the redirect after login, the cookie scope and the log links in notifications; not for worker traffic.
# Behind nginx (misc/nginx.conf terminates TLS on 8080): https://<nginx_host>:8080, i.e. scheme and port of nginx,
# not of the api-server container.
AIRFLOW_BASE_URL=https://<apiserver_host>:8080
# Airflow 3: secret to sign the tokens between api-server, workers and UI (identical on all machines)
AIRFLOW_JWT_SECRET=<secret>

#POSTGRES_HOST=<postgres_host>  # access on another machine
POSTGRES_HOST=postgres-service  # access within docker-compose network, set POSTGRES_PORT=5432
POSTGRES_PORT=5432
POSTGRES_USER=<postgres_user>
#POSTGRES_PASSWORD=<password>
POSTGRES_DB=airflow

#REDIS_HOST=<redis_host>  # access on another machine
REDIS_HOST=redis-service  # access within docker-compose network
REDIS_PORT=6379

# all mounts (backup pool folders, results pool folders, instruments) need to be available in MOUNTS_PATH, cf. Readme
# Note: must be absolute (if relative, e.g. in local tests, docker job runner will not work)
MOUNTS_PATH=/home/kraken-user/alphakraken/production/mounts
