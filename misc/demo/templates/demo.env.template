# Environment for docker-compose for the self-contained demo (ENV=demo).
#
# GENERATED FILE -- do not edit, it is overwritten by misc/demo/setup_demo.sh.
# Edit misc/demo/templates/demo.env.template instead.

ENV_NAME=demo

# The app ports are bound to loopback only: the UUID path behind nginx is the sole way in.
# These variables control host publishing only, the in-container ports are fixed in docker-compose.yaml.
WEBSERVER_PORT=127.0.0.1:8080
WEBAPP_PORT=127.0.0.1:8501
MCP_PORT=127.0.0.1:8089
REST_API_PORT=127.0.0.1:8090

# Serving the components behind a single UUID path prefix (cf. misc/demo/.state/nginx.conf).
# Streamlit picks up every config option from STREAMLIT_<SECTION>_<OPTION>.
STREAMLIT_SERVER_BASE_URL_PATH=__UUID__
WEBAPP_HEALTHCHECK_URL=http://localhost:8501/__UUID__/healthz
# Airflow mounts the whole app under the path of its base_url, so /health moves along with it.
AIRFLOW_BASE_URL=https://__DEMO_HOST__/__UUID__/airflow
AIRFLOW_HEALTHCHECK_URL=http://localhost:8080/__UUID__/airflow/health
REST_API_ROOT_PATH=/__UUID__/api

# credentials for Airflow UI
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

MONGO_USER_READWRITE=mongo
MONGO_PASSWORD_READWRITE=mongo
MONGO_USER_READ=mongoread
MONGO_PASSWORD_READ=mongoread
MONGO_USER_WEBAPP=mongowebapp
MONGO_PASSWORD_WEBAPP=mongowebapp

# access through compose-internal network (service name)
MONGO_HOST=mongodb-service
MONGO_PORT=27017

POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

REDIS_HOST=redis-service
REDIS_PORT=6379

MOUNTS_PATH=./misc/demo/mounts

# The demo runs the quanting jobs through the `docker` job engine, whose optional requirements are
# only installed into the airflow image if this is set at build time.
INSTALL_DOCKER_ENGINE=true

# Group id of the docker group, required by the `docker` job engine so the worker can start
# quanting containers through the mounted docker socket.
DOCKER_GID=__DOCKER_GID__
